#!/bin/bash
# Removes claude-sandbox worktrees (<repo>/.claude/worktrees/<task>) whose
# branch is already merged into the upstream default branch and whose
# working tree is clean. Locked worktrees (in use by another session) and
# ones with uncommitted changes are left alone in the default bulk mode —
# never force-removed there. Use --force <name> to override for one
# specific, explicitly-named worktree instead.
#
# Usage: claude-sandbox-prune [--apply]
#   (no args)     dry run — reports what would be removed and why anything is skipped
#   --apply       actually removes the eligible worktrees
#
#        claude-sandbox-prune --force <name>
#   Removes exactly that one worktree regardless of lock state or
#   uncommitted changes. A lock usually means "a session's worktree
#   feature registered this and never cleanly unregistered it" (e.g. after
#   a crash) rather than "something is using it right now" — but if a
#   container/session for <name> is actually still running, stop it first;
#   this does not check for that.
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

if [ "${1:-}" = "--force" ]; then
    if [ -z "${2:-}" ]; then
        echo "usage: $(basename "$0") --force <name>" >&2
        exit 1
    fi
    FORCE_NAME="$2"
    REPO_ROOT="$(resolve_repo_root)"
    FORCE_WT_PATH="$REPO_ROOT/.claude/worktrees/$FORCE_NAME"

    if [ ! -d "$FORCE_WT_PATH" ]; then
        echo "error: no worktree at $FORCE_WT_PATH" >&2
        exit 1
    fi

    LOCK_REASON="$(git -C "$REPO_ROOT" worktree list --porcelain | awk -v p="$FORCE_WT_PATH" '
        /^worktree /{path=$2; reason=""}
        path==p && /^locked/{$1=""; reason=substr($0,2)}
        path==p && /^$/{if (reason!="") print reason; exit}
    ')"
    if [ -n "$LOCK_REASON" ]; then
        echo "overriding lock: $LOCK_REASON"
    fi
    if [ -n "$(git -C "$FORCE_WT_PATH" status --porcelain 2>/dev/null)" ]; then
        echo "warning: uncommitted changes in this worktree will be lost"
    fi

    remove_worktree "$REPO_ROOT" "$FORCE_WT_PATH"
    echo "force-removed $FORCE_NAME"
    exit 0
fi

APPLY=0
if [ "${1:-}" = "--apply" ]; then
    APPLY=1
fi

REPO_ROOT="$(resolve_repo_root)"
WORKTREES_DIR="$REPO_ROOT/.claude/worktrees"
CURRENT_ROOT="$(git rev-parse --show-toplevel)"

if [ ! -d "$WORKTREES_DIR" ]; then
    echo "no worktrees under $WORKTREES_DIR"
    exit 0
fi

DEFAULT_BRANCH="$(git -C "$REPO_ROOT" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')"
DEFAULT_BRANCH="${DEFAULT_BRANCH:-master}"
git -C "$REPO_ROOT" fetch origin "$DEFAULT_BRANCH" --quiet 2>/dev/null || true

WT_INFO="$(mktemp)"
trap 'rm -f "$WT_INFO"' EXIT

# One porcelain pass, parsed into path/branch/locked rows — avoids
# re-invoking `git worktree list` per worktree and works without
# associative arrays (macOS ships bash 3.2 by default).
git -C "$REPO_ROOT" worktree list --porcelain | awk '
    /^worktree /{path=$2; locked=0; branch=""}
    /^branch /{branch=$2; sub("refs/heads/","",branch)}
    /^locked/{locked=1}
    /^$/{if (path!="") {print path"\t"branch"\t"locked; path=""}}
' > "$WT_INFO"

removable=0
skipped=0

while IFS=$'\t' read -r wt_path branch locked; do
    case "$wt_path" in
        "$WORKTREES_DIR"/*) ;;
        *) continue ;; # not one of this tool's worktrees — never touch it
    esac
    # Not basename — task names can contain "/" (e.g. "feature/FSDS-4280-x"
    # for a pre-commit hook's branch naming convention), so the worktree
    # path nests. basename would truncate to just the last segment, which
    # would then feed a wrong, incomplete path back into --force.
    name="${wt_path#"$WORKTREES_DIR"/}"

    if [ "$wt_path" = "$CURRENT_ROOT" ]; then
        echo "skip     $name  ($branch)  — this session"
        skipped=$((skipped + 1))
        continue
    fi

    if [ "$locked" = "1" ]; then
        echo "skip     $name  ($branch)  — locked, in use by another session"
        echo "           sure it's not actually in use? $(basename "$0") --force $name"
        skipped=$((skipped + 1))
        continue
    fi

    if [ -z "$branch" ] || ! git -C "$REPO_ROOT" merge-base --is-ancestor "$branch" "origin/$DEFAULT_BRANCH" 2>/dev/null; then
        echo "skip     $name  ($branch)  — not merged into origin/$DEFAULT_BRANCH"
        echo "           branch stays intact either way; remove just the checkout: $(basename "$0") --force $name"
        skipped=$((skipped + 1))
        continue
    fi

    if [ -n "$(git -C "$wt_path" status --porcelain)" ]; then
        echo "skip     $name  ($branch)  — merged, but has uncommitted changes; stash or commit first"
        echo "           sure you want to discard those changes? $(basename "$0") --force $name"
        skipped=$((skipped + 1))
        continue
    fi

    if [ "$APPLY" -eq 1 ]; then
        remove_worktree "$REPO_ROOT" "$wt_path"
        echo "removed  $name  ($branch)"
    else
        echo "remove   $name  ($branch)  — merged into origin/$DEFAULT_BRANCH, clean, unlocked"
    fi
    removable=$((removable + 1))
done < "$WT_INFO"

echo
if [ "$APPLY" -eq 1 ]; then
    echo "removed $removable, skipped $skipped"
else
    echo "$removable removable, $skipped skipped — dry run, pass --apply to actually remove"
fi
